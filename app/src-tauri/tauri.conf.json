{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris Notch",
  "version": "0.2.0",
  "identifier": "it.irisvolto.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Iris Notch",
        "width": 180,
        "height": 70,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Iris Notch: il volto del tuo agente Hermes, in cima allo schermo",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ]
      }
    },
    "publisher": "Variety Project",
    "copyright": "© 2026 Variety Project — PolyForm Noncommercial 1.0.0"
  }
}
